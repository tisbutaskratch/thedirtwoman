ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/adventure_planner
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:5173"]

# Uploads. Set all four to store attachments in an S3-compatible bucket
# (Cloudflare R2); leave them unset and uploads go to MEDIA_ROOT on local
# disk. Deployments must set them: Render's filesystem does not persist.
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
