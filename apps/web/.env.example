# Base URL of the API. In development the dev server proxies /api; in
# production set this to the deployed API, e.g. https://api.example.com
VITE_API_BASE_URL=/api

# Which product this build is: "planner" or, by default, the resume.
# Leave unset for local development and both are served from one dev server,
# with the planner under /app. Netlify sets this per site.
# VITE_SITE=planner

# Each site links to the other, so each build needs the other's origin.
# Unset locally, where the cross-links stay same-origin.
# VITE_RESUME_URL=https://sabawilhelm.com
# VITE_PLANNER_URL=https://thedirthags.com
